diff --git a/src/c_extensions/align_accel.c b/src/c_extensions/align_accel.c
index e07618b..3137f50 100644
--- a/src/c_extensions/align_accel.c
+++ b/src/c_extensions/align_accel.c
@@ -90,7 +90,12 @@ static int align_one(
     }
 
     /* Full ptr table needed for traceback — allocate on heap (64-bit size). */
-    char *ptr_table = (char *)malloc(((size_t)m + 1) * cols_sz * sizeof(char));
+    /* calloc, not malloc. The fill loop writes only [j_min..j_max] of each row, so
+     * the out-of-band columns were never assigned, yet the traceback reads
+     * ptr_table[i*cols_sz + j]. Reading heap garbage there made every caller
